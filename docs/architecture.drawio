        <mxCell id="c8" value="Cloud Logging / Monitoring&#10;error &gt; 1% · lag &gt; 15 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1100" y="200" width="220" height="70" as="geometry"/>
